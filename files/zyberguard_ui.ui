          <column><property name="text"><string>Saved On</string></property></column>
          <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
          <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
          <property name="alternatingRowColors"><bool>true</bool></property>
         </widget>
        </item>
       </layout>
      </widget>

      <!-- ==== PAGE 4: IP LOOKUP ==== -->
      <widget class="QWidget" name="pageIpLookup">
       <layout class="QVBoxLayout" name="ipOuterLayout">
        <property name="leftMargin"><number>32</number></property>
        <property name="topMargin"><number>28</number></property>
        <property name="rightMargin"><number>32</number></property>
        <property name="bottomMargin"><number>28</number></property>
        <property name="spacing"><number>14</number></property>
        <item>
         <widget class="QLabel" name="ipTitleLabel">
          <property name="text"><string>IP Address Lookup</string></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="ipSubtitleLabel">
          <property name="text"><string>Investigate a suspicious IP address using geolocation data</string></property>
         </widget>
        </item>

        <item>
         <layout class="QHBoxLayout" name="ipInputLayout">
          <property name="spacing"><number>10</number></property>
          <item>
           <widget class="QLineEdit" name="leIpAddress">
            <property name="placeholderText"><string>e.g. 8.8.8.8</string></property>
            <property name="minimumSize"><size><width>0</width><height>40</height></size></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnLookupIp">
            <property name="text"><string>🔎  Lookup</string></property>
            <property name="minimumSize"><size><width>120</width><height>40</height></size></property>
            <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
           </widget>
          </item>
         </layout>
        </item>

        <item>
         <widget class="QProgressBar" name="pbIpLoading">
          <property name="minimum"><number>0</number></property>
          <property name="maximum"><number>0</number></property>
          <property name="visible"><bool>false</bool></property>
          <property name="textVisible"><bool>false</bool></property>
          <property name="minimumSize"><size><width>0</width><height>8</height></size></property>
         </widget>
        </item>

        <item>
         <widget class="QFrame" name="ipResultFrame">
          <layout class="QFormLayout" name="ipResultLayout">
           <property name="leftMargin"><number>20</number></property>
           <property name="topMargin"><number>18</number></property>
           <property name="rightMargin"><number>20</number></property>
           <property name="bottomMargin"><number>18</number></property>
           <property name="horizontalSpacing"><number>14</number></property>
           <property name="verticalSpacing"><number>12</number></property>
           <item row="0" column="0"><widget class="QLabel" name="ipTagCountry"><property name="text"><string>Country</string></property></widget></item>
           <item row="0" column="1"><widget class="QLabel" name="lblIpCountry"><property name="text"><string>—</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="ipTagCity"><property name="text"><string>City</string></property></widget></item>
           <item row="1" column="1"><widget class="QLabel" name="lblIpCity"><property name="text"><string>—</string></property></widget></item>
           <item row="2" column="0"><widget class="QLabel" name="ipTagRegion"><property name="text"><string>Region</string></property></widget></item>
           <item row="2" column="1"><widget class="QLabel" name="lblIpRegion"><property name="text"><string>—</string></property></widget></item>
           <item row="3" column="0"><widget class="QLabel" name="ipTagTimezone"><property name="text"><string>Timezone</string></property></widget></item>
           <item row="3" column="1"><widget class="QLabel" name="lblIpTimezone"><property name="text"><string>—</string></property></widget></item>
           <item row="4" column="0"><widget class="QLabel" name="ipTagIsp"><property name="text"><string>ISP</string></property></widget></item>
           <item row="4" column="1"><widget class="QLabel" name="lblIpIsp"><property name="text"><string>—</string></property></widget></item>
           <item row="5" column="0"><widget class="QLabel" name="ipTagCoords"><property name="text"><string>Coordinates</string></property></widget></item>
           <item row="5" column="1"><widget class="QLabel" name="lblIpCoords"><property name="text"><string>—</string></property></widget></item>
          </layout>
         </widget>
        </item>

        <item>
         <spacer name="ipBottomSpacer">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
          <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
         </spacer>
        </item>
       </layout>
      </widget>

      <!-- ==== PAGE 5: REPORT ==== -->
      <widget class="QWidget" name="pageReport">
       <layout class="QVBoxLayout" name="reportOuterLayout">
